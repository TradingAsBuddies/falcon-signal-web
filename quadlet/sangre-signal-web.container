# sangre-signal-web — container deployment.
#
# No host paths, no build step, no source on the target. The image is built
# elsewhere (`make image`, or CI) and referenced by tag; state lives in a named
# volume. That makes this unit identical on every host and removes the whole
# class of problems that came with a bind-mounted build context: 9p cannot back
# an overlay, a 9p mount is readable by exactly one uid, and it is not present
# when units first start at boot.
[Unit]
Description=Sangre Signal Web (Falcon)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/sangre-signal-web:latest
ContainerName=sangre-signal-web
Network=falcon.network
PublishPort=5000:5000
Volume=sangre-signal-data.volume:/app/data
Environment=FLASK_ENV=production
Environment=PORT=5000
# Required only for identity-linked Anthropic keys; an identifier, not a credential.
Environment=ANTHROPIC_WORKSPACE_ID=
Secret=anthropic-api-key,type=env,target=ANTHROPIC_API_KEY
Secret=perplexity-api-key,type=env,target=PERPLEXITY_API_KEY
# curl is not installed in the image (only gcc and git are); python always is.
HealthCmd=python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:5000/status', timeout=5).status==200 else 1)"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=40s
Label=project=falcon
Label=service=signal-web

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target default.target

# sangre-signal-nginx — the old compose `profiles: [production]`.
#
# A profile has no quadlet equivalent, so this is a separate unit with NO
# [Install] section: it exists but never auto-starts. Enable it deliberately:
#   systemctl --user enable --now sangre-signal-nginx.service
#
# nginx.conf is baked into the image (see Containerfile.nginx) rather than
# bind-mounted from the host, and TLS material is a podman secret rather than a
# host directory. Neither belongs on the target filesystem.
[Unit]
Description=Sangre Signal nginx (Falcon, production profile)
After=network-online.target sangre-signal-web.service
Wants=network-online.target
Requires=sangre-signal-web.service

[Container]
Image=localhost/sangre-signal-nginx:latest
ContainerName=sangre-signal-nginx
Network=falcon.network
PublishPort=80:80
PublishPort=443:443
Secret=sangre-signal-tls-cert,type=mount,target=/etc/nginx/ssl/tls.crt
Secret=sangre-signal-tls-key,type=mount,target=/etc/nginx/ssl/tls.key
Label=project=falcon
Label=service=signal-nginx

[Service]
Restart=always
RestartSec=5
